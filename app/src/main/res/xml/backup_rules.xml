<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices running API 30 and lower.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices running API 31 and higher,
   see data_extraction_rules.xml.
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Session cookies (CookiePreferencesStore) must not leave the device. -->
    <exclude
        domain="file"
        path="datastore/cookie_data.bin" />
    <exclude
        domain="file"
        path="datastore/cookie_data.json" />
</full-backup-content>
