<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for devices running API 31 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Session cookies (CookiePreferencesStore) must not leave the device. -->
        <exclude
            domain="file"
            path="datastore/cookie_data.bin" />
        <exclude
            domain="file"
            path="datastore/cookie_data.json" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/cookie_data.bin" />
        <exclude
            domain="file"
            path="datastore/cookie_data.json" />
    </device-transfer>
</data-extraction-rules>
